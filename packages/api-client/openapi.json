        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["version"],
                "additionalProperties": false,
                "properties": {
                  "version": { "type": "integer", "minimum": 1 },
                  "rateBps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "recipients": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["order", "kind", "splitBps"],
                      "additionalProperties": false,
                      "properties": {
                        "order": { "type": "integer", "minimum": 1 },
                        "kind": {
                          "type": "string",
                          "enum": ["BROKER", "OFFICE"]
                        },
                        "splitBps": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        }
                      }
                    }
                  }
                },
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["version"],
                    "additionalProperties": false,
                    "properties": {
                      "version": { "type": "integer", "minimum": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["version", "rateBps", "recipients"],
                    "additionalProperties": false,
                    "properties": {
                      "version": { "type": "integer", "minimum": 1 },
                      "rateBps": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      },
                      "recipients": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["order", "kind", "splitBps"],
                          "additionalProperties": false,
                          "properties": {
                            "order": { "type": "integer", "minimum": 1 },
                            "kind": {
                              "type": "string",
                              "enum": ["BROKER", "OFFICE"]
                            },
                            "splitBps": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10000
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": { "201": { "description": "" } },
        "summary": "",
        "tags": ["Commission"]
      }
    },
