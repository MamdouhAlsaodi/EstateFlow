{
  "name": "@estateflow/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "pnpm exec eslint src --max-warnings=0",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:integration": "node -e \"console.log('No design-token integration tests exist before EF-106.')\"",
    "build": "pnpm exec tsc --project tsconfig.json && cp src/styles.css dist/styles.css"
  }
}
