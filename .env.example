# Copy this file to .env for local-only development. Never commit the resulting file.
# Every value below is a placeholder. Replace it only with values for your isolated local setup.

# Local development database and cache
POSTGRES_LOCAL_DB=YOUR_LOCAL_DATABASE_NAME
POSTGRES_LOCAL_USER=YOUR_LOCAL_DATABASE_USER
POSTGRES_LOCAL_PASSWORD=YOUR_LOCAL_DATABASE_PASSWORD
POSTGRES_LOCAL_PORT=YOUR_LOCAL_DATABASE_PORT
REDIS_LOCAL_PORT=YOUR_LOCAL_REDIS_PORT
DATABASE_URL=YOUR_LOCAL_DATABASE_URL

# Isolated test database and cache
POSTGRES_TEST_DB=YOUR_TEST_DATABASE_NAME
POSTGRES_TEST_USER=YOUR_TEST_DATABASE_USER
POSTGRES_TEST_PASSWORD=YOUR_TEST_DATABASE_PASSWORD
POSTGRES_TEST_PORT=YOUR_TEST_DATABASE_PORT
REDIS_TEST_PORT=YOUR_TEST_REDIS_PORT

# Test safety: enable only for the isolated test database.
ALLOW_DESTRUCTIVE_TESTS=YOUR_TEST_SAFETY_FLAG

# Reserved for the planned authentication domain; do not reuse local values in production.
SESSION_SECRET=YOUR_LOCAL_SESSION_SECRET
TOKEN_SECRET=YOUR_LOCAL_TOKEN_SECRET

# API runtime secret; required when NODE_ENV is production.
ESTATEFLOW_API_SECRET=YOUR_LOCAL_API_SECRET
