model CommissionAccrual {
  id                     String                    @id @db.Uuid
  organizationId         String                    @db.Uuid
  dealId                 String                    @db.Uuid
  dealClosedWonEventId   String                    @db.Uuid
  commissionableValueId  String                    @db.Uuid
  commissionPlanVersionId String                   @db.Uuid
  totalAmountMinor       BigInt                    @db.BigInt
  currency               String                    @db.VarChar(3)
  status                 String                    @db.VarChar(20)
  createdAt              DateTime                  @db.Timestamptz(6)
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal                    Deal                      @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  event                   DealDomainEvent           @relation(fields: [organizationId, dealClosedWonEventId], references: [organizationId, id], onDelete: Restrict)
  value                   CommissionableValue       @relation(fields: [organizationId, commissionableValueId], references: [organizationId, id], onDelete: Restrict)
  plan                    CommissionPlanVersion    @relation(fields: [organizationId, commissionPlanVersionId], references: [organizationId, id], onDelete: Restrict)
  splits                  CommissionAccrualSplit[]

  @@unique([organizationId, id])
  @@unique([organizationId, dealClosedWonEventId])
  @@index([organizationId, dealId])
