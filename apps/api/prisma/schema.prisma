generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionRevocationReason {
  LOGOUT
  REFRESH_REPLAY
  PASSWORD_RESET
  SECURITY_EVENT
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

enum OrganizationRole {
  OWNER
  MANAGER
  BROKER
  CLIENT
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AuthAttemptReason {
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  RATE_LIMITED
}

enum AuthRateLimitEndpoint {
  REGISTRATION
  LOGIN
  PASSWORD_RECOVERY
  PASSWORD_RESET
  REFRESH
}

enum AuthRateLimitDimension {
  ACCOUNT
  CLIENT_SOURCE
}

enum AuthRateLimitOutcome {
  ALLOWED
  REJECTED
}

enum SecurityAuditOutcome {
  ALLOWED
  DENIED
}

enum PropertyStatus {
  ACTIVE
  ARCHIVED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ImageMediaType {
  JPEG
  PNG
  WEBP
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  NURTURING
  CLOSED_WON
  CLOSED_LOST
}

enum LeadTimelineEventType {
  LEAD_CREATED
  LEAD_ASSIGNED
  LEAD_STAGE_CHANGED
  LEAD_NEXT_ACTION_CHANGED
  LEAD_NOTE_ADDED
  LEAD_TASK_CREATED
  LEAD_TASK_COMPLETED
  LEAD_TASK_RESCHEDULED
  LEAD_CLOSED_WON
  LEAD_CLOSED_LOST
}
enum LeadTaskStatus {
  OPEN
  COMPLETED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalSide {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

model User {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountIdentifier   String              @unique
  platformRole        PlatformRole        @default(NONE)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  verifiedAt          DateTime?           @db.Timestamptz(6)
  credential          Credential?
  sessionFamilies     SessionFamily[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  memberships         Membership[]        @relation("MembershipUser")
  approvedMemberships Membership[]        @relation("MembershipApprover")
  ownedLeads          Lead[]              @relation("LeadOwner")
  cancelledInvoices   Invoice[]           @relation("InvoiceCancelledBy")
}

model Organization {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  memberships            Membership[]
  properties             Property[]
  listings               Listing[]
  leads                  Lead[]
  leadIdempotencyRecords LeadIdempotencyRecord[]
  deals                  Deal[]
  dealDomainEvents       DealDomainEvent[]
  accounts               Account[]
  accountingPeriods      AccountingPeriod[]
  journalEntries         JournalEntry[]
  journalLines           JournalLine[]
  commissionPlans        CommissionPlanVersion[]
  commissionValues       CommissionableValue[]
  commissionAccruals     CommissionAccrual[]
  invoices               Invoice[]
  receivables            Receivable[]
  paymentRecords         PaymentRecord[]
  expenses               Expense[]
  expenseEvidence        ExpenseEvidenceMetadata[]
  expenseApprovalPolicy  ExpenseApprovalPolicy?
  campaigns                        Campaign[]
  campaignTransitions              CampaignTransition[]
  campaignBudgetCorrections        CampaignBudgetCorrection[]
  campaignPerformanceEntries       CampaignPerformanceEntry[]
  leadTouches                      LeadTouch[]
  leadAttributionCorrections       LeadAttributionCorrection[]
  contentItems                     ContentItem[]
  contentTransitions               ContentTransition[]
}

// EF-401 — Campaigns and attribution.

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignChannel {
  META
  GOOGLE
  SNAPCHAT
  TIKTOK
  X
  LINKEDIN
  PRINT
  OUTDOOR
  REFERRAL
  OTHER
}

enum TouchChannel {
  WEBSITE
  WHATSAPP
  PHONE_CALL
  WALK_IN
  REFERRAL
  META
  GOOGLE
  SNAPCHAT
  TIKTOK
  X
  OTHER
}

model Campaign {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String          @db.Uuid
  name               String          @db.VarChar(200)
  objective          String          @db.VarChar(500)
  channel            CampaignChannel
  status             CampaignStatus  @default(DRAFT)
  startsAt           DateTime        @db.Timestamptz(6)
  endsAt             DateTime        @db.Timestamptz(6)
  budgetPlannedMinor BigInt          @db.BigInt
  currency           String          @db.VarChar(3)
  utmSource          String?         @db.VarChar(100)
  utmMedium          String?         @db.VarChar(100)
  utmCampaign        String?         @db.VarChar(100)
  utmContent         String?         @db.VarChar(100)
  utmTerm            String?         @db.VarChar(100)
  createdBy          String          @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transitions        CampaignTransition[]
  budgetCorrections  CampaignBudgetCorrection[]
  performanceEntries CampaignPerformanceEntry[]
  touches            LeadTouch[]
  attributionCorrections LeadAttributionCorrection[]
  expenses           Expense[]
  contentItems       ContentItem[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model CampaignTransition {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  campaignId     String         @db.Uuid
  fromStatus     CampaignStatus
  toStatus       CampaignStatus
  reason         String?        @db.VarChar(500)
  actorId        String         @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  campaign       Campaign       @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, campaignId, createdAt])
}

model CampaignBudgetCorrection {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  campaignId     String   @db.Uuid
  previousMinor  BigInt   @db.BigInt
  correctedMinor BigInt   @db.BigInt
  currency       String   @db.VarChar(3)
  reason         String   @db.VarChar(500)
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  campaign       Campaign @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, campaignId, createdAt])
}

model CampaignPerformanceEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  campaignId     String   @db.Uuid
  occurredAt     DateTime @db.Timestamptz(6)
  impressions    Int
  clicks         Int
  leadsCount     Int
  note           String?  @db.VarChar(500)
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  campaign       Campaign @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, campaignId, occurredAt])
}

model LeadTouch {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  leadId         String       @db.Uuid
  campaignId     String?      @db.Uuid
  channel        TouchChannel
  source         String?      @db.VarChar(200)
  utmSource      String?      @db.VarChar(100)
  utmMedium      String?      @db.VarChar(100)
  utmCampaign    String?      @db.VarChar(100)
  utmContent     String?      @db.VarChar(100)
  utmTerm        String?      @db.VarChar(100)
  occurredAt     DateTime     @db.Timestamptz(6)
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  campaign       Campaign?    @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, campaignId])
}

model LeadAttributionCorrection {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @db.Uuid
  leadId              String   @db.Uuid
  previousCampaignId  String?  @db.Uuid
  correctedCampaignId String?  @db.Uuid
  reason              String   @db.VarChar(500)
  createdBy           String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  campaign            Campaign? @relation(fields: [organizationId, correctedCampaignId], references: [organizationId, id], onDelete: Restrict)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, leadId, createdAt])
}

model Membership {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @db.Uuid
  userId           String           @db.Uuid
  role             OrganizationRole
  status           MembershipStatus
  approvedByUserId String?          @db.Uuid
  approvedAt       DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  approvedByUser   User?            @relation("MembershipApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  ownedLeads       Lead[]           @relation("LeadOwnerMembership")
  brokerDeals      Deal[]           @relation("DealBrokerMembership")

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, role, status])
  @@index([userId, status])
}

model Credential {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionFamily {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                   @db.Uuid
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  revokedAt       DateTime?                @db.Timestamptz(6)
  revokedReason   SessionRevocationReason?
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessSessions  AccessSession[]
  refreshSessions RefreshSession[]

  @@index([userId, revokedAt])
}

model AccessSession {
  id        String        @id @db.Uuid
  familyId  String        @db.Uuid
  tokenHash String        @unique
  csrfHash  String
  issuedAt  DateTime      @db.Timestamptz(6)
  expiresAt DateTime      @db.Timestamptz(6)
  revokedAt DateTime?     @db.Timestamptz(6)
  family    SessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model RefreshSession {
  id                String          @id @db.Uuid
  familyId          String          @db.Uuid
  tokenHash         String          @unique
  csrfHash          String
  issuedAt          DateTime        @db.Timestamptz(6)
  lastUsedAt        DateTime        @db.Timestamptz(6)
  absoluteExpiresAt DateTime        @db.Timestamptz(6)
  idleExpiresAt     DateTime        @db.Timestamptz(6)
  consumedAt        DateTime?       @db.Timestamptz(6)
  revokedAt         DateTime?       @db.Timestamptz(6)
  replacedById      String?         @unique @db.Uuid
  family            SessionFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  replacedBy        RefreshSession? @relation("RefreshReplacement", fields: [replacedById], references: [id])
  replaces          RefreshSession? @relation("RefreshReplacement")

  @@index([familyId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model PasswordReset {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  secretHash String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model EmailVerification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  secretHash String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model AuthAttempt {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountKeyHash      String
  clientSourceKeyHash String
  reason              AuthAttemptReason
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)

  @@index([accountKeyHash, createdAt])
  @@index([clientSourceKeyHash, createdAt])
}

model AuthRateLimitEvent {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpoint  AuthRateLimitEndpoint
  dimension AuthRateLimitDimension
  keyHash   String
  outcome   AuthRateLimitOutcome
  createdAt DateTime               @default(now()) @db.Timestamptz(6)

  @@index([endpoint, dimension, keyHash, createdAt])
}

model SecurityAuditEvent {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId            String?              @db.Uuid
  outcome              SecurityAuditOutcome
  reason               String
  requestCorrelationId String
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)

  @@index([subjectId, createdAt])
  @@index([createdAt])
}

model Property {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  title          String
  propertyType   String
  addressText    String
  ownerReference String?
  status         PropertyStatus @default(ACTIVE)
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  listings           Listing[]
  deals              Deal[]
  expenses           Expense[]
  sourceContentItems ContentItem[]  @relation("ContentSourceProperty")

  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model Listing {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  propertyId     String          @db.Uuid
  status         ListingStatus   @default(DRAFT)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property        @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  images         ImageMetadata[]

  @@index([organizationId, propertyId, status])
}

model Lead {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                  @db.Uuid
  ownerId            String                  @db.Uuid
  stage              LeadStage               @default(NEW)
  nextAction         String
  source             String
  utm                Json?
  version            Int                     @default(1)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner              User                    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  ownerMembership    Membership              @relation("LeadOwnerMembership", fields: [organizationId, ownerId], references: [organizationId, userId], onDelete: Restrict)
  timelineEvents     LeadTimelineEvent[]
  idempotencyRecords LeadIdempotencyRecord[]
  notes              LeadNote[]
  tasks              LeadTask[]
  deals              Deal[]

  @@unique([organizationId, id])
  @@index([organizationId, ownerId])
  @@index([organizationId, stage])
}

model Deal {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  leadId         String            @db.Uuid
  propertyId     String            @db.Uuid
  brokerId       String            @db.Uuid
  status         String            @default("OPEN")
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead           Lead              @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict)
  property       Property          @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  broker         Membership        @relation("DealBrokerMembership", fields: [organizationId, brokerId], references: [organizationId, userId], onDelete: Restrict)
  domainEvents         DealDomainEvent[]
  commissionableValue  CommissionableValue?
  commissionAccruals   CommissionAccrual[]
  invoices             Invoice[]
  receivables          Receivable[]
  expenses             Expense[]

  @@unique([organizationId, id])
  @@unique([organizationId, leadId])
}

model Invoice {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @db.Uuid
  dealId          String       @db.Uuid
  amountMinor     BigInt       @db.BigInt
  currency        String       @db.VarChar(3)
  status          String       @db.VarChar(20)
  draftCreatedBy  String       @db.Uuid
  draftCreatedAt  DateTime     @db.Timestamptz(6)
  issuedBy          String?       @db.Uuid
  issuedAt          DateTime?     @db.Timestamptz(6)
  dueAt             DateTime?     @db.Timestamptz(6)
  cancelledBy       String?       @db.Uuid
  cancelledAt       DateTime?     @db.Timestamptz(6)
  cancellationReason String?
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal              Deal          @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  cancelledByUser   User?         @relation("InvoiceCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  receivable        Receivable?

  @@unique([organizationId, id])
  @@index([organizationId, dealId])
  @@index([cancelledBy])
}

model Receivable {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String          @db.Uuid
  invoiceId           String          @db.Uuid
  dealId              String          @db.Uuid
  originalAmountMinor BigInt          @db.BigInt
  outstandingMinor    BigInt          @db.BigInt
  currency            String          @db.VarChar(3)
  status              String          @db.VarChar(20)
  issuedAt            DateTime        @db.Timestamptz(6)
  dueAt               DateTime        @db.Timestamptz(6)
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice             Invoice         @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  deal                Deal            @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  paymentRecords      PaymentRecord[]

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceId])
  @@index([organizationId, dealId])
  @@index([organizationId, status, dueAt, id])
}

model PaymentRecord {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @db.Uuid
  receivableId       String       @db.Uuid
  amountMinor        BigInt       @db.BigInt
  currency           String       @db.VarChar(3)
  recordedAt         DateTime     @db.Timestamptz(6)
  recordedBy         String       @db.Uuid
  commandScope       String       @db.VarChar(64)
  idempotencyKey     String       @db.VarChar(200)
  commandPayloadHash String       @db.VarChar(64)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receivable         Receivable   @relation(fields: [organizationId, receivableId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, commandScope, idempotencyKey])
  @@index([organizationId, receivableId])
}

model DealDomainEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  dealId         String       @db.Uuid
  type           String
  schemaVersion  Int
  occurredAt     DateTime     @db.Timestamptz(6)
  data              Json
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal              Deal               @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  commissionAccrual CommissionAccrual?

  @@unique([organizationId, id])
  @@index([organizationId, dealId, occurredAt])
}

model LeadTimelineEvent {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  leadId         String                @db.Uuid
  idempotencyId  String                @db.Uuid
  type           LeadTimelineEventType
  occurredAt     DateTime              @db.Timestamptz(6)
  data           Json
  lead           Lead                  @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict)
  idempotency    LeadIdempotencyRecord @relation(fields: [organizationId, idempotencyId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, leadId, occurredAt])
  @@index([idempotencyId])
}

model LeadNote {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  leadId         String       @db.Uuid
  body           String
  createdByUserId String      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  lead           Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, leadId, createdAt])
}

model LeadTask {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  leadId         String         @db.Uuid
  title          String
  dueAt          DateTime       @db.Timestamptz(6)
  status         LeadTaskStatus @default(OPEN)
  completedAt    DateTime?      @db.Timestamptz(6)
  version        Int            @default(1)
  createdByUserId String        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  lead           Lead           @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, leadId, status, dueAt])
}

model LeadIdempotencyRecord {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @db.Uuid
  commandScope   String              @db.VarChar(64)
  idempotencyKey String              @db.VarChar(255)
  payloadHash    String              @db.VarChar(64)
  leadId         String              @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead           Lead                @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict)
  timelineEvents LeadTimelineEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, commandScope, idempotencyKey])
  @@index([organizationId, leadId])
}

model Account {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  code           String       @db.VarChar(64)
  name           String       @db.VarChar(200)
  type           AccountType
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalLines   JournalLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model AccountingPeriod {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                    @db.Uuid
  startsAt       DateTime                  @db.Timestamptz(6)
  endsAt         DateTime                  @db.Timestamptz(6)
  status         AccountingPeriodStatus
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([organizationId, id])
  @@index([organizationId, startsAt, endsAt, status])
}

model JournalEntry {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String         @db.Uuid
  status            JournalStatus  @default(DRAFT)
  currency          String         @db.VarChar(3)
  reference         String         @db.VarChar(200)
  reason            String         @db.VarChar(200)
  actorId           String         @db.Uuid
  createdAt         DateTime       @db.Timestamptz(6)
  postedAt          DateTime?      @db.Timestamptz(6)
  periodId          String?        @db.Uuid
  reversalOfEntryId String?        @db.Uuid
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period            AccountingPeriod? @relation(fields: [organizationId, periodId], references: [organizationId, id], onDelete: Restrict)
  reversalOf        JournalEntry? @relation("JournalReversal", fields: [organizationId, reversalOfEntryId], references: [organizationId, id], onDelete: Restrict)
  reversals         JournalEntry[] @relation("JournalReversal")
  lines             JournalLine[]

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, periodId, status])
  @@index([organizationId, reversalOfEntryId])
}

model JournalLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  entryId        String       @db.Uuid
  accountId      String       @db.Uuid
  side           JournalSide
  amountMinor    BigInt       @db.BigInt
  currency       String       @db.VarChar(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entry          JournalEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  account        Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, entryId])
  @@index([organizationId, accountId])
}

model CommissionPlanVersion {
