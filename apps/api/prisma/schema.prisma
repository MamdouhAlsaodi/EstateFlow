  amountMinor    BigInt            @db.BigInt
  currency       String            @db.VarChar(3)
  accrual        CommissionAccrual @relation(fields: [organizationId, accrualId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, accrualId, order])
  @@index([organizationId, accrualId, order])
}

model ImageMetadata {
