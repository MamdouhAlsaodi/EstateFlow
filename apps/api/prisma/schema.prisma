model CommissionPlanRecipient {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  planVersionId  String                @db.Uuid
  order          Int
  kind           String                @db.VarChar(20)
  splitBps       Int
  plan           CommissionPlanVersion @relation(fields: [organizationId, planVersionId], references: [organizationId, id], onDelete: Restrict)

